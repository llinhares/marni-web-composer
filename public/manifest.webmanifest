{
  "name": "Marni Web Composer",
  "short_name": "Marni",
  "description": "DAW e compositor de partituras para Black Desert Online: piano roll, gravação MIDI, mixer e exportação para o jogo.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#141210",
  "theme_color": "#141210",
  "icons": [
    { "src": "MWC_Logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/vnd.marni.project+json": [".marni"] }
    }
  ]
}
